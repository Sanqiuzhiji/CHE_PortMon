QWidget {
    background: #202020;
    color: #e6e6e6;
    font-size: 13px;
}

QMainWindow {
    background: #202020;
}

QFrame#sidebarFrame {
    background: #181818;
    border-right: 1px solid #303030;
}

QLabel#appTitleLabel {
    color: #f4f7fb;
    font-size: 18px;
    font-weight: 700;
    padding: 18px 16px 10px 16px;
}

QFrame#sidebarFrame QPushButton {
    background: transparent;
    border: 0;
    color: #c8c8c8;
    font-size: 14px;
    padding: 12px 18px;
    text-align: left;
}

QFrame#sidebarFrame QPushButton:hover {
    background: #2a2a2a;
    color: #ffffff;
}

QFrame#sidebarFrame QPushButton[active="true"] {
    background: #26384d;
    border-left: 3px solid #2d8cff;
    color: #ffffff;
    font-weight: 600;
}

QFrame#topStatusFrame {
    background: #252525;
    border-bottom: 1px solid #3a3a3a;
}

QFrame#topStatusFrame QLabel {
    color: #dddddd;
    font-size: 13px;
    padding: 0 8px;
}

QStackedWidget {
    background: #202020;
}

QSplitter#ioSplitter::handle {
    background: #303030;
    border: 1px solid #444444;
    border-radius: 2px;
}

QSplitter#ioSplitter::handle:vertical {
    height: 6px;
}

QSplitter#ioSplitter::handle:hover {
    background: #3d4e63;
    border-color: #2d8cff;
}

QLabel {
    color: #dddddd;
}

QLabel#connectionTitleLabel {
    color: #f0f0f0;
    font-size: 22px;
    font-weight: 700;
}

QLabel#uartTabLabel {
    background: #303030;
    border: 1px solid #2d8cff;
    border-bottom: 2px solid #2d8cff;
    border-radius: 4px;
    color: #ffffff;
    font-size: 12px;
    font-weight: 600;
    padding: 5px 18px;
}

QTabWidget#connectionProtocolTabs {
    background: #202020;
}

QTabWidget#connectionProtocolTabs::pane {
    background: #202020;
    border: 0;
    margin-top: 8px;
}

QTabWidget#connectionProtocolTabs QTabBar {
    background: #202020;
}

QTabWidget#connectionProtocolTabs QTabBar::tab {
    background: #303030;
    border: 1px solid #505050;
    border-radius: 12px;
    color: #d8d8d8;
    font-size: 12px;
    font-weight: 600;
    margin-right: 8px;
    min-height: 24px;
    min-width: 64px;
    padding: 4px 18px;
}

QTabWidget#connectionProtocolTabs QTabBar::tab:selected {
    background: #26384d;
    border-color: #2d8cff;
    color: #ffffff;
}

QTabWidget#connectionProtocolTabs QTabBar::tab:hover {
    background: #3d4e63;
    border-color: #2d8cff;
    color: #ffffff;
}

QFrame#titleAccentFrame {
    background: #2d8cff;
    border-radius: 2px;
}

QGroupBox {
    background: #292929;
    border: 1px solid #444444;
    border-radius: 4px;
    color: #f0f0f0;
    font-weight: 600;
    margin-top: 10px;
    padding: 6px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    left: 10px;
    padding: 0 6px;
}

QFrame#receivePanelFrame,
QFrame#sendBarFrame,
QFrame#receiveToolbarFrame {
    background: #252525;
    border: 1px solid #404040;
    border-radius: 4px;
}

QFrame#receiveToolbarFrame {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

QPushButton,
QToolButton {
    background: #343434;
    border: 1px solid #505050;
    border-radius: 4px;
    color: #eeeeee;
    min-height: 24px;
    padding: 4px 12px;
}

QPushButton:hover,
QToolButton:hover {
    background: #3d4e63;
    border-color: #2d8cff;
}

QPushButton:pressed,
QToolButton:pressed {
    background: #225f9f;
    border-color: #409eff;
}

QPushButton[active="true"],
QPushButton:checked,
QToolButton:checked {
    background: #2d8cff;
    border-color: #409eff;
    color: #ffffff;
}

QPushButton#toggleButton {
    background: #2d8cff;
    border-color: #409eff;
    color: #ffffff;
    font-weight: 600;
}

QPushButton#toggleButton[connected="true"] {
    background: #3b3b3b;
    border-color: #f56c6c;
    color: #ffb3b3;
}

QPushButton#hexToggleButton,
QPushButton#sendFormatToggleButton,
QPushButton#timestampButton,
QPushButton#autoScrollButton {
    min-height: 24px;
    padding: 3px 8px;
}

QPushButton#hexToggleButton,
QPushButton#sendFormatToggleButton {
    font-weight: 600;
    min-width: 48px;
}

QPushButton#timestampButton,
QPushButton#autoScrollButton {
    padding: 3px;
}

QToolButton#sendToolButton {
    background: #2d8cff;
    border: 1px solid #409eff;
    border-radius: 4px;
    color: #ffffff;
    font-weight: 600;
    min-height: 24px;
    padding: 4px 12px;
}

QToolButton#sendToolButton:hover {
    background: #409eff;
}

QToolButton#sendToolButton::menu-button {
    border-left: 1px solid #7bbdff;
    width: 20px;
}

QToolButton#sendToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: center right;
    right: 6px;
}

QMenu#sendSettingsMenu {
    background: #ffffff;
    border: 1px solid #d6e4f0;
    border-radius: 6px;
    color: #303133;
    padding: 6px;
}

QMenu#sendSettingsMenu::item {
    background: transparent;
    color: #303133;
    padding: 6px 28px 6px 24px;
}

QMenu#sendSettingsMenu::item:selected {
    background: #eaf4ff;
    color: #1677d2;
}

QMenu#sendSettingsMenu::separator {
    background: #e6eaf0;
    height: 1px;
    margin: 6px 4px;
}

QWidget#sendMenuRow {
    background: #ffffff;
}

QLabel#sendMenuLabel {
    background: transparent;
    color: #303133;
    min-width: 105px;
}

QCheckBox#sendMenuCheckBox,
QRadioButton#sendMenuRadioButton {
    background: transparent;
    color: #303133;
    spacing: 8px;
}

QCheckBox#sendMenuCheckBox::indicator,
QRadioButton#sendMenuRadioButton::indicator {
    background: #ffffff;
    border: 1px solid #9fb7cf;
    height: 14px;
    width: 14px;
}

QCheckBox#sendMenuCheckBox::indicator:checked,
QRadioButton#sendMenuRadioButton::indicator:checked {
    background: #1677d2;
    border-color: #1677d2;
}

QPushButton#sendMenuStepButton {
    background: #f3f8ff;
    border: 1px solid #bddcff;
    border-radius: 3px;
    color: #1677d2;
    font-weight: 700;
    max-width: 22px;
    min-height: 20px;
    min-width: 22px;
    padding: 0;
}

QSpinBox#sendMenuSpinBox {
    background: #ffffff;
    border: 1px solid #cfd8e3;
    border-radius: 3px;
    color: #303133;
    min-height: 20px;
    padding: 1px 4px;
}

QFrame#hexHintFrame {
    background: #272b34;
    border: 1px solid #ffb020;
    border-radius: 8px;
}

QLabel#hexHintLabel {
    background: transparent;
    color: #fff2cc;
    font-size: 13px;
    font-weight: 600;
}

QProgressBar#hexHintProgress {
    background: #3a3a3a;
    border: 0;
    border-radius: 2px;
    max-height: 4px;
    min-height: 4px;
}

QProgressBar#hexHintProgress::chunk {
    background: #ffb020;
    border-radius: 2px;
}

QComboBox,
QLineEdit,
QSpinBox,
QDoubleSpinBox {
    background: #303030;
    border: 1px solid #505050;
    border-radius: 4px;
    color: #f0f0f0;
    min-height: 24px;
    padding: 4px 8px;
    selection-background-color: #2d8cff;
    selection-color: #ffffff;
}

QComboBox:hover,
QLineEdit:hover,
QSpinBox:hover,
QDoubleSpinBox:hover {
    border-color: #2d8cff;
}

QComboBox:focus,
QLineEdit:focus,
QSpinBox:focus,
QDoubleSpinBox:focus {
    border-color: #409eff;
}

QComboBox QAbstractItemView {
    background: #303030;
    border: 1px solid #505050;
    color: #f0f0f0;
    selection-background-color: #2d8cff;
    selection-color: #ffffff;
    outline: 0;
}

QTextEdit,
QPlainTextEdit {
    background: #1e1e1e;
    border: 1px solid #444444;
    border-radius: 4px;
    color: #eeeeee;
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
    padding: 8px;
    selection-background-color: #2d8cff;
    selection-color: #ffffff;
}

QPlainTextEdit#receivePlainTextEdit {
    background: #181818;
    border-top-left-radius: 0;
    border-top-right-radius: 0;
}

QCheckBox,
QRadioButton {
    color: #dddddd;
    spacing: 6px;
}

QCheckBox::indicator,
QRadioButton::indicator {
    background: #303030;
    border: 1px solid #606060;
    height: 14px;
    width: 14px;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    background: #2d8cff;
    border-color: #409eff;
}

QScrollBar:vertical {
    background: #252525;
    width: 10px;
}

QScrollBar::handle:vertical {
    background: #555555;
    border-radius: 4px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover {
    background: #666666;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0;
}

QLabel#protocolTitleLabel {
    color: #f0f0f0;
    font-size: 22px;
    font-weight: 700;
    min-width: 180px;
}

QFrame#protocolToolbarFrame {
    background: #202020;
}

QFrame#libraryContainer,
QFrame#canvasContainer,
QFrame#propertyContainer,
QWidget#protocolLibraryPanel,
QWidget#protocolCanvasPanel,
QWidget#protocolPropertyPanel {
    background: #252525;
    border: 1px solid #404040;
    border-radius: 6px;
}

QLabel#protocolPanelTitleLabel {
    background: transparent;
    color: #f0f0f0;
    font-size: 14px;
    font-weight: 700;
}

QWidget#protocolFieldTemplateButton {
    background: #2b2b2b;
    border: 1px solid #404040;
    border-radius: 6px;
}

QWidget#protocolFieldTemplateButton:hover {
    background: #333a42;
    border-color: #2d8cff;
}

QLabel#protocolTemplateTitleLabel {
    background: transparent;
    color: #ffffff;
    font-size: 13px;
    font-weight: 700;
}

QLabel#protocolTemplateMetaLabel {
    background: transparent;
    color: #aab2bd;
    font-size: 11px;
}

QScrollArea#protocolCanvasScrollArea {
    background: #252525;
    border: 0;
}

QScrollArea#protocolCanvasScrollArea QWidget {
    background: #252525;
}

QLabel#protocolFrameLabel {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    color: #ffffff;
    font-size: 15px;
    font-weight: 700;
    padding: 4px 8px;
}

QLabel#protocolFrameLabel[selected="true"] {
    background: #26384d;
    border-color: #2d8cff;
    color: #ffffff;
}

QLabel#protocolFrameDragHandle {
    background: #303030;
    border: 1px solid #505050;
    border-radius: 4px;
    color: #9aa4b2;
    font-size: 11px;
    padding: 3px 8px;
}

QWidget#protocolFieldBlock {
    background: #2b2b2b;
    border: 2px solid transparent;
    border-radius: 7px;
    min-width: 128px;
}

QWidget#protocolFieldBlock[selected="true"] {
    border: 2px solid #2d8cff;
    background: #22364d;
}

QFrame#protocolInsertIndicator {
    background: #2d8cff;
    border: 0;
    min-height: 84px;
    max-height: 120px;
}

QFrame#protocolFrameInsertIndicator {
    background: #2d8cff;
    border: 0;
    min-height: 3px;
    max-height: 3px;
}

QLabel#protocolFieldNameLabel,
QLabel#protocolFieldMetaLabel,
QLabel#protocolFieldRangeLabel {
    background: transparent;
}

QLabel#protocolFieldNameLabel {
    color: #ffffff;
    font-weight: 700;
}

QLabel#protocolFieldMetaLabel,
QLabel#protocolFieldRangeLabel {
    color: #b7c0cc;
    font-size: 11px;
}

QLabel#protocolFieldDragHandle {
    background: #303030;
    border: 1px dashed #505050;
    border-radius: 4px;
    color: #9aa4b2;
    font-size: 10px;
    padding: 2px 5px;
}
