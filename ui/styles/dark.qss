QMainWindow {
    background: #eef1f5;
}

QFrame#sidebarFrame {
    background: #171c24;
}

QLabel#appTitleLabel {
    color: #f4f7fb;
    font-size: 18px;
    font-weight: 700;
    padding: 18px 16px 10px 16px;
}

QFrame#sidebarFrame QPushButton {
    border: 0;
    color: #c7d0dc;
    font-size: 14px;
    padding: 12px 18px;
    text-align: left;
}

QFrame#sidebarFrame QPushButton:hover {
    background: #242b36;
    color: #ffffff;
}

QFrame#sidebarFrame QPushButton[active="true"] {
    background: #2f80ed;
    color: #ffffff;
    font-weight: 600;
}

QFrame#topStatusFrame {
    background: #ffffff;
    border-bottom: 1px solid #d8dee8;
}

QFrame#topStatusFrame QLabel {
    color: #344054;
    font-size: 13px;
    padding: 0 8px;
}

QStackedWidget {
    background: #eef1f5;
}

QGroupBox,
QWidget#card {
    background: #ffffff;
    border: 1px solid #d8dee8;
    border-radius: 8px;
    margin-top: 12px;
    padding: 14px;
}

QGroupBox::title {
    color: #1d2939;
    subcontrol-origin: margin;
    left: 12px;
    padding: 0 6px;
    font-weight: 600;
}

QPushButton {
    background: #2f80ed;
    border: 1px solid #2f80ed;
    border-radius: 6px;
    color: #ffffff;
    padding: 8px 14px;
}

QPushButton:hover {
    background: #1f6ed4;
}

QPushButton:disabled {
    background: #c8d0dc;
    border-color: #c8d0dc;
}

QComboBox,
QLineEdit,
QTextEdit {
    background: #ffffff;
    border: 1px solid #c7d0dc;
    border-radius: 6px;
    color: #101828;
    padding: 7px;
    selection-background-color: #2f80ed;
}

QTextEdit#receiveTextEdit,
QTextEdit#sendTextEdit {
    font-family: Consolas, "Courier New", monospace;
    font-size: 12px;
}

QCheckBox,
QRadioButton,
QLabel {
    color: #1d2939;
    font-size: 13px;
}
